{
  "name": "hrms",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @hrms/api --filter @hrms/web dev",
    "build": "pnpm --filter @hrms/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @hrms/db generate",
    "db:migrate": "pnpm --filter @hrms/db migrate",
    "db:seed": "pnpm --filter @hrms/db seed",
    "release": "pnpm build && pnpm --filter @hrms/api run deploy"
  },
  "engines": {
    "node": ">=20"
  }
}
